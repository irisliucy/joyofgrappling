ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Optional, and only one of the two options below is needed. Only relevant
# on cloud hosts (Render, Fly, AWS, etc.) -- YouTube blocks its unofficial
# transcript endpoint from datacenter IPs, so caption fetching fails there
# without a proxy. Not needed for local development on a residential/home
# IP.
#
# Option A: Webshare's residential proxy product specifically
# (https://www.webshare.io) -- youtube-transcript-api has built-in support
# for it.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
#
# Option B: any other proxy provider (Bright Data, Smartproxy, IPRoyal,
# Oxylabs, a self-hosted proxy, ...) as a plain proxy URL. Only used if the
# Webshare vars above are unset.
PROXY_HTTP_URL=
PROXY_HTTPS_URL=
