ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Optional. Only needed on cloud hosts (Render, Fly, AWS, etc.) -- YouTube
# blocks its unofficial transcript endpoint from datacenter IPs, so caption
# fetching fails there without a residential proxy. Get these from
# https://www.webshare.io (their "Residential" proxy product). Not needed
# for local development on a residential/home IP.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
